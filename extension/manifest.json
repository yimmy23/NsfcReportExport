{
    "update_url": "https://clients2.google.com/service/update2/crx",
    "manifest_version": 3,
    "name": "国自然结题报告下载 直连诊断",
    "description": "只从已打开的官网结题详情页直连导出 PDF。1.5.3 在业务 JSON 上给出脱敏诊断，不把页地址发给第三方。",
    "version": "1.5.3",
    "key": "",
    "icons": {
        "512": "images/logo.png"
    },
    "action": {
        "icons": {
            "512": "images/logo.png"
        },
        "default_title": "从当前官网页导出PDF"
    },
    "background": {
        "service_worker": "service_worker.js"
    },
    "host_permissions": [
        "https://kd.nsfc.cn/*"
    ],
    "permissions": [
        "downloads",
        "notifications",
        "contextMenus",
        "scripting",
        "activeTab",
        "downloads.open",
        "alarms",
        "storage",
        "unlimitedStorage"
    ]
}
